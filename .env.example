PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://sunity:sunity@db:5432/sunity
BETTER_AUTH_URL=http://localhost:3000

# Ganti placeholder ini dengan kredensial yang valid
BETTER_AUTH_SECRET=replace-with-your-own-secret
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

FRONTEND_URLS=http://localhost:5173,https://sunity.sayyidrafee.com,https://sunity-web.vercel.app
